{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ls-plugin/carousel-slide",
  "version": "1.0.0",
  "title": "Carousel Slide",
  "category": "media",
  "description": "A single slide within the carousel.",
  "keywords": [
    "slide",
    "carousel"
  ],
  "textdomain": "ls-plugin",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "parent": [
    "ls-plugin/carousel"
  ],
  "supports": {
    "html": false,
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "__experimentalDefaultControls": {
        "color": true,
        "radius": false,
        "width": true
      }
    },
    "color": {
      "gradients": true,
      "link": true,
      "__experimentalDefaultControls": {
        "link": false
      }
    },
    "spacing": {
      "padding": true,
      "__experimentalDefaultControls": {
        "padding": true
      }
    }
  },
  "attributes": {
    "verticalAlign": {
      "type": "string"
    }
  }
}